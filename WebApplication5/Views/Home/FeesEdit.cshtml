@{
    ViewBag.Title = "Edit Fees";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container mt-5 mb-5" style="max-width: 1000px;">
    <div class="main-dashboard-card p-4 p-md-5">
        <h3 class="form-title mb-4">
            <i class="bi bi-currency-rupee me-2"></i>Edit Fees
        </h3>

        <div class="row g-3 align-items-end mb-4">
            <div class="col-md-6">
                <label class="form-label-custom">Select Student</label>
                <select id="studentSelect" class="form-select form-control-premium">
                    <option value="">-- Select Student --</option>
                    @foreach (var item in ViewBag.StudentList)
                    {
                        <option value="@item.Key">@item.Value</option>
                    }
                </select>
            </div>
        </div>

        <div id="enrollmentTableWrapper" style="display:none;">
            <hr />
            <h5 class="fw-bold mb-3">
                <i class="bi bi-journal-text me-2 text-primary"></i>Enrollments & Fees
            </h5>
            <div class="table-responsive">
                <table class="table table-custom align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Course</th>
                            <th>Type</th>
                            <th>Enrolled On</th>
                            <th>Status</th>
                            <th style="width:140px;">Total Fees</th>
                            <th style="width:140px;">Fees Paid</th>
                            <th style="width:140px;">Remaining</th>
                            <th style="width:100px;">Action</th>
                        </tr>
                    </thead>
                    <tbody id="enrollmentTableBody">
                    </tbody>
                </table>
            </div>
            <div id="noDataMessage" class="text-center text-muted py-4 d-none">
                <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                No enrollments found for this student.
            </div>
        </div>

        <div id="selectStudentPrompt" class="text-center text-muted py-5">
            <i class="bi bi-person-search fs-1 d-block mb-3"></i>
            <p class="fs-5">Select a student to view their enrollment fees.</p>
        </div>
    </div>
</div>

<!-- Save Confirmation Modal -->
<div class="modal" id="feeEditModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(135deg, #4f46e5, #6366f1); color:white;">
                <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2"></i>Edit Fee</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="feeEditModalBody">
                <input type="hidden" id="editEnrollmentId" />
                <div class="mb-3">
                    <label class="form-label-custom">Course</label>
                    <p class="fw-bold" id="editCourseName"></p>
                </div>
                <div class="mb-3">
                    <label class="form-label-custom">Total Fees (Rs.)</label>
                    <p class="fw-bold text-primary fs-5" id="editTotalFees"></p>
                </div>
                <div class="mb-3">
                    <label class="form-label-custom">Fees Paid (Rs.)</label>
                    <input type="number" id="editFeesPaid" class="form-control form-control-custom" step="0.01" min="0" />
                </div>
                <div class="mb-3">
                    <label class="form-label-custom">Remaining Fees (Rs.)</label>
                    <p class="fw-bold" id="editRemainingFees"></p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-premium-primary" id="btnSaveFeeEdit">
                    <i class="bi bi-check-lg me-1"></i>Save Changes
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    var getStudentEnrollmentsUrl = '@Url.Action("GetStudentEnrollmentsWithFees", "Home")';
    var saveFeeUrl = '@Url.Action("SaveFee", "Home")';
</script>
<script src="~/Scripts/feesEdit.js?v=@DateTime.Now.Ticks"></script>