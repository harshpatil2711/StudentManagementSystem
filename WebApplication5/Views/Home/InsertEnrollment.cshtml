@model BusinessLayer.ViewModels.EnrollmentInsertViewModel
@{
    var isEdit = Model.EnrollmentID.HasValue && Model.EnrollmentID.Value > 0;

    ViewBag.Title = isEdit
        ? "Edit Enrollment"
        : "Add Enrollment";

    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container mt-5 mb-5" style="max-width: 850px;">
    <div class="main-dashboard-card p-4 p-md-5">
        <h3 class="form-title mb-4">
            <i class="bi @(isEdit ? "bi-pencil-square" : "bi-plus-circle") me-2"></i>
            @(isEdit ? "Edit Enrollment" : "New Enrollment")
        </h3>

        @Html.Partial("_EnrollmentForm", Model)

        <!-- Selected Skills Table -->
        <div id="skillsTableSection" class="mt-4" style="display:none;">
            <hr />
            <h5 class="fw-bold mb-3">
                <i class="bi bi-list-check me-2 text-primary"></i>Selected Skills
            </h5>
            <div class="table-responsive">
                <table class="table table-bordered align-middle" id="skillsTable">
                    <thead class="table-light">
                        <tr>
                            <th>Skill</th>
                            <th style="width:120px;">Monthly Fee</th>
                            <th style="width:100px;">Months</th>
                            <th style="width:120px;">Total Fee</th>
                            <th style="width:60px;"></th>
                        </tr>
                    </thead>
                    <tbody id="skillsTableBody">
                    </tbody>
                    <tfoot>
                        <tr class="fw-bold">
                            <td colspan="3" class="text-end">Grand Total:</td>
                            <td id="grandTotalDisplay">Rs. 0.00</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Skill Selection Modal -->
<div class="modal" id="skillModal" tabindex="-1" aria-labelledby="skillModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(135deg, #4f46e5, #6366f1); color:white;">
                <h5 class="modal-title fw-bold" id="skillModalTitle">
                    <i class="bi bi-gear me-2"></i>Select Skills
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="skillModalBody">
                <div id="skillListContainer"></div>
                <div class="mt-3 p-3 bg-light rounded border fw-bold">
                    Total Fees: Rs. <span id="skillModalTotal">0.00</span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-premium-primary" id="btnAddSkillsConfirm">
                    <i class="bi bi-check-lg me-1"></i>Add Selected
                </button>
            </div>
        </div>
    </div>
</div>

<!-- URL variables for external JS (server-side Url.Action cannot run in .js files) -->
<script>
    var insertEnrollmentUrl = '@Url.Action("InsertEnrollment", "Home")';
    var indexUrl = '@Url.Action("Index", "Home")';
    var getSkillsByOfferingUrl = '@Url.Action("GetSkillsByOffering", "Home")';
    var initialSelectedSkills = '@Model.SelectedSkills';
</script>
<script src="~/Scripts/insertEnrollment.js?v=@DateTime.Now.Ticks"></script>
