@model BusinessLayer.Models.Student
@{
    ViewBag.Title = "Delete Student";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8 col-12">
        <div class="form-card text-center">

            <!-- Header -->
            <div class="mb-4">
                <i class="bi bi-exclamation-triangle-fill" style="font-size: 3rem; color: #ef4444;"></i>
                <h2 class="form-title mt-2">Delete Student</h2>
                <p class="text-muted">Are you sure you want to delete this student?</p>
            </div>

            <!-- Photo + Info -->
            <div class="mb-4">
                @if (!string.IsNullOrEmpty(Model.PhotoPath))
                {
                    <img src="@Model.PhotoPath" class="img-thumbnail delete-photo mb-3" alt="@Model.StudentName" />
                }
                else
                {
                    <div class="delete-photo-placeholder mx-auto mb-3">
                        <i class="bi bi-person-fill" style="font-size: 3rem; color: #818cf8;"></i>
                    </div>
                }
                <h5 class="fw-bold mb-1">@Model.StudentName</h5>
                <p class="text-muted mb-1">ID: @Model.StudentID</p>
                @if (!string.IsNullOrEmpty(Model.Email))
                {
                    <p class="text-muted mb-0">@Model.Email</p>
                }
            </div>

            <!-- Warning -->
            <div class="alert alert-warning mx-auto" style="max-width: 400px;">
                <i class="bi bi-info-circle me-1"></i>
                This action will deactivate the student record. The student photo will also be removed from the server.
            </div>

            <!-- Action Buttons -->
            <div class="d-flex flex-wrap gap-2.5 mt-4 justify-content-center">
                <a href="@Url.Action("Index", "Student")" class="btn btn-premium-secondary px-4">
                    <i class="bi bi-arrow-left me-1.5"></i>Cancel
                </a>
                <button type="button" id="btnDelete" class="btn btn-danger px-5" style="background: linear-gradient(135deg, #ef4444, #dc2626); border: none;">
                    <i class="bi bi-trash me-1.5"></i>Delete Student
                </button>
            </div>

            <!-- Message -->
            <div id="message" class="mt-4"></div>
        </div>
    </div>
</div>

<style>
    .delete-photo {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #fecaca;
    }
    .delete-photo-placeholder {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: linear-gradient(135deg, #fee2e2, #fecaca);
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

<script>
    var deleteConfirmUrl = '@Url.Action("DeleteConfirm", "Student")';
    var studentId = @Model.StudentID;
    var studentListUrl = '@Url.Action("Index", "Student")';
</script>
<script>
    $(document).ready(function () {
        $("#btnDelete").click(function () {
            $(this).prop("disabled", true).html('<span class="spinner-border spinner-border-sm me-1.5" role="status"></span>Deleting...');

            $.ajax({
                url: deleteConfirmUrl,
                type: "POST",
                data: { id: studentId },
                success: function (response) {
                    if (response.toLowerCase().indexOf("success") !== -1) {
                        $("#message").html(
                            '<div class="alert alert-success"><i class="bi bi-check-circle-fill me-2"></i>' + response + '</div>'
                        );
                        setTimeout(function () { window.location.href = studentListUrl; }, 1200);
                    } else {
                        $("#btnDelete").prop("disabled", false).html('<i class="bi bi-trash me-1.5"></i>Delete Student');
                        $("#message").html(
                            '<div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>' + response + '</div>'
                        );
                    }
                },
                error: function () {
                    $("#btnDelete").prop("disabled", false).html('<i class="bi bi-trash me-1.5"></i>Delete Student');
                    $("#message").html(
                        '<div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>An error occurred. Please try again.</div>'
                    );
                }
            });
        });
    });
</script>
