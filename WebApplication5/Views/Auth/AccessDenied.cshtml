@{
    ViewBag.Title = "Access Denied";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="main-dashboard-card p-5">
                <i class="bi bi-shield-exclamation text-danger" style="font-size: 5rem;"></i>
                <h2 class="dashboard-title mt-3">Access Denied</h2>
                <p class="text-muted">You do not have permission to access this page.</p>
                <a href="@Url.Action("Index", "Home")" class="btn btn-premium-primary">
                    <i class="bi bi-house-fill me-2"></i>Back to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
