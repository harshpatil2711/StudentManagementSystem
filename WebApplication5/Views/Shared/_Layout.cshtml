<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Student Management System</title>

    <!-- Google Fonts - Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- iziToast -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/izitoast/dist/css/iziToast.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/izitoast/dist/js/iziToast.min.js"></script>

    <!-- Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

    <!-- Custom CSS -->
    @Styles.Render("~/Content/css")
    
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
</head>
<body class="min-vh-100 d-flex flex-column">

    <!-- Premium Glassmorphism Navbar -->
    <nav class="navbar navbar-expand-md navbar-light navbar-premium sticky-top">
        <div class="container-fluid max-width-lg">
            <a class="navbar-brand-premium" href="/Home/Index">
                <i class="bi bi-mortarboard-fill fs-3 text-primary"></i>
                <span>SMS Portal</span>
            </a>
            
            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav gap-1 mt-2 mt-md-0">
                    <li class="nav-item">
                        <a class="nav-link nav-link-premium" href="/Home/Index">
                            <i class="bi bi-grid-1x2-fill me-2 opacity-75"></i>Dashboard
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-premium" href="/Student/StudentInsert">
                            <i class="bi bi-person-plus-fill me-2 opacity-75"></i>Add Student
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-premium" href="/Home/InsertEnrollment">
                            <i class="bi bi-journal-plus me-2 opacity-75"></i>Add Enrollment
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-premium" href="/Home/FeesEdit">
                            <i class="bi bi-currency-rupee me-2 opacity-75"></i>Edit Fees
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link nav-link-premium" href="/Home/GetList">
                            <i class="bi bi-list-columns-reverse me-2 opacity-75"></i>Dynamic List
                        </a>
                    </li>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link nav-link-premium dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><span class="dropdown-item-text text-muted small">
                                    @{
                                        var user = Session["UserSession"] as BusinessLayer1.Models.UserSession;
                                    }
                                    @(user?.FullName ?? User.Identity.Name)
                                </span></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>@Html.ActionLink("Logout", "Logout", "Auth", null, new { @class = "dropdown-item" })</li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link nav-link-premium" href="/Auth/Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Login
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-premium" href="/Auth/SignUp">
                                <i class="bi bi-person-plus me-1"></i>Sign Up
                            </a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content Container -->
    <main class="flex-grow-1">
        <div class="container-fluid px-4 px-md-5 mx-auto body-content" style="max-width: 1500px;">
            @RenderBody()
        </div>
    </main>

    <!-- Premium Footer -->
    <footer class="footer-premium text-center">
        <div class="container">
            <p class="m-0">&copy; @DateTime.Now.Year - Student Management Portal. Crafted for Excellence.</p>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @RenderSection("scripts", required: false)

    <!-- Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

     @*Bootstrap 5 JS Bundle*@ 
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
    $.fn.modal = function (action) {
        var el = this[0];
        if (!el) return this;
        var modal = bootstrap.Modal.getInstance(el);
        if (!modal) modal = new bootstrap.Modal(el);
        if (action === 'show') modal.show();
        else if (action === 'hide') modal.hide();
        else if (action === 'toggle') modal.toggle();
        return this;
    };
    </script>
    
    <!-- Layout JS -->
    <script src="~/Scripts/layout.js"></script>
</body>
</html>
