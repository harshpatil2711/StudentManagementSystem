@model BusinessLayer1.Models.StudentFeeInfo

@{
    bool isNew = !Model.StudentFeeID.HasValue;
    bool isSkill = Model.CourseType == "Skill";
    decimal suggestedTotal = Model.CourseFees ?? 0;
    if (Model.TotalFees == 0 && !isSkill) Model.TotalFees = suggestedTotal;
}

<div class="p-3">
    <input type="hidden" id="feeEnrollmentId" value="@Model.EnrollmentID" />

    <div class="row g-3">
        <div class="col-12 mb-2">
            <div class="detail-label">Enrollment ID</div>
            <div class="detail-value">#@Model.EnrollmentID</div>
        </div>

        @if (isSkill)
        {
            <div class="col-12 mb-2">
                <div class="detail-label">Course Type</div>
                <span class="badge bg-info text-dark">Skill</span>
            </div>
            <div class="col-12 mb-3">
                <label class="form-label-custom">Total Fees (from selected skills)</label>
                <input type="text" class="form-control form-control-custom" readonly
                       value="Rs. @Model.TotalFees.ToString("N2")" />
                <input type="hidden" id="feeTotalFees" value="@Model.TotalFees" />
            </div>
        }
        else
        {
            <div class="col-12 mb-2">
                <div class="detail-label">Course Type</div>
                <span class="badge bg-secondary text-white">Academic</span>
            </div>
            @if (suggestedTotal > 0)
            {
                <div class="col-12 mb-1">
                    <small class="text-muted">Fee: Rs. @suggestedTotal.ToString("N2")
                        (per semester)</small>
                </div>
            }
            <div class="col-12 mb-3">
                <label class="form-label-custom">Total Fees (Rs.)</label>
                <input type="number" id="feeTotalFees" class="form-control form-control-custom"
                       value="@Model.TotalFees.ToString("F2")" step="0.01" min="0" />
            </div>
        }

        <div class="col-12 mb-3">
            <label class="form-label-custom">Fees Paid (Rs.)</label>
            <input type="number" id="feeFeesPaid" class="form-control form-control-custom"
                   value="@(Model.FeesPaid?.ToString("F2") ?? "0.00")" step="0.01" min="0" />
        </div>
    </div>

    <div class="d-flex gap-3 mt-4">
        <button type="button" id="btnSaveFee" class="btn btn-submit-premium">
            @(isNew ? "Add Fees" : "Update Fees")
        </button>
    </div>
</div>

<style>
    .detail-label {
        font-size: 0.8rem;
        font-weight: 600;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 2px;
    }
    .detail-value {
        font-size: 1rem;
        font-weight: 600;
        color: #0f172a;
    }
</style>
