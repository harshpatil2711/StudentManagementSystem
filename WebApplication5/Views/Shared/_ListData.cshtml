@model BusinessLayer.ViewModels.EnrollmentViewModel
<input type="hidden" id="enrollcount"     value="@Model.Enrollmentcount" />
<input type="hidden" id="sortColumn"      value="@Model.SortColumn" />
<input type="hidden" id="sortDirection"   value="@Model.SortDirection" />
@if (Model != null)
{
    <div class="table-responsive">
        <table class="table table-custom align-middle">
            <thead>
                <tr>
                    <th scope="col" class="sortable-th" data-sort="EnrollmentId">
                        Enrollment ID <span class="sort-icon ms-1">&#8597;</span>
                    </th>
                    <th scope="col" class="sortable-th" data-sort="StudentName">
                        Student Name <span class="sort-icon ms-1">&#8597;</span>
                    </th>
                    <th scope="col" class="sortable-th" data-sort="CourseName">
                        Course Offered <span class="sort-icon ms-1">&#8597;</span>
                    </th>
                    <th scope="col" class="sortable-th" data-sort="EnrollmentDate">
                        Enrollment Date <span class="sort-icon ms-1">&#8597;</span>
                    </th>
                    <th scope="col" class="sortable-th" data-sort="EnrollmentStatus">
                        Status <span class="sort-icon ms-1">&#8597;</span>
                    </th>
                    <th scope="col" style="width:110px;">
                        Fees
                    </th>
                    <th scope="col" class="text-dark fw-bold text-center"
                        style="color:#0f172a !important;font-weight:800 !important;font-size:0.82rem;letter-spacing:0.5px;width:130px;">
                        Actions
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Enrollments)
                {
                    var statusClass = "badge-status-pending";
                    var statusLower = item.EnrollmentStatus?.ToLower() ?? "";
                    if (statusLower.Contains("active") || statusLower.Contains("approved"))
                    {
                        statusClass = "badge-status-active";
                    }
                    else if (statusLower.Contains("complete") || statusLower.Contains("success"))
                    {
                        statusClass = "badge-status-completed";
                    }
                    else if (statusLower.Contains("cancel") || statusLower.Contains("drop") || statusLower.Contains("reject"))
                    {
                        statusClass = "badge-status-cancelled";
                    }

                    <tr class="table-row-hover">
                        <td data-label="Enrollment ID" class="fw-bold text-dark" style="color: #0f172a !important;">#@item.EnrollmentID</td>
                        <td data-label="Student">
                            <div class="d-flex align-items-center">
                                <div class="avatar-circle me-2">
                                    @(string.IsNullOrEmpty(item.StudentName) ? "S" : item.StudentName.Substring(0, 1).ToUpper())
                                </div>
                                <span class="fw-bold text-dark" style="color: #0f172a !important;">@item.StudentName</span>
                            </div>
                        </td>
                        <td data-label="Course">
                            <span class="badge bg-secondary-subtle text-dark border border-secondary-subtle px-2 py-1 fw-bold" style="color: #0f172a !important;">@item.CourseName</span>
                        </td>
                        <td data-label="Enrolled" class="text-dark fw-bold" style="color: #1e293b !important; white-space:nowrap;">
                            <i class="bi bi-calendar3 me-1 text-primary"></i>
                            @item.EnrollmentDate.ToString("yyyy-MM-dd")
                        </td>
                        <td data-label="Status">
                            <span class="badge-status @statusClass">
                                @item.EnrollmentStatus
                            </span>
                        </td>
                        <td data-label="Fees" class="text-center align-middle" style="white-space:nowrap;">
                            @if (item.TotalFees.HasValue)
                            {
                                <span class="fw-bold text-dark" style="font-size:0.9rem;">Rs. @item.TotalFees.Value.ToString("N2")</span>
                            }
                            else
                            {
                                <span class="text-muted fw-semibold" style="font-size:0.82rem;">Not Set</span>
                            }
                        </td>
                        <td data-label="" class="text-center">
                            <div class="d-flex flex-row gap-1 justify-content-center">
                                <a href="@Url.Action("DownloadReceipt", "Report", new { id = item.EnrollmentID })"
                                   class="btn btn-sm btn-success-outline fw-bold"
                                   title="Download Receipt" target="_blank">
                                    <i class="bi bi-download"></i>
                                </a>
                                @if (User.IsInRole("Admin") || User.IsInRole("Admission Officer"))
                                {
                                    <button class="btn btn-sm btn-premium-outline fw-bold edit-btn"
                                            data-id="@item.EnrollmentID"
                                            title="Edit">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                }
                                @if (User.IsInRole("Admin"))
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-danger-outline fw-bold delete-btn"
                                            data-id="@item.EnrollmentID"
                                            title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
